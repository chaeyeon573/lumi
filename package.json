{
  "name": "aroundu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:static": "VITE_ROUTER=hash VITE_MAP_TILES=off vite build --base ./ --outDir dist-static",
    "typecheck": "tsc -b",
    "mobile": "npm --prefix apps/mobile run tunnel",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "start": "npm run server",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "import:courses": "tsx --tsconfig server/tsconfig.json server/scripts/import-courses.ts",
    "import:orgs": "tsx --tsconfig server/tsconfig.json server/scripts/import-orgs.ts",
    "fetch:orgs": "tsx --tsconfig server/tsconfig.json server/scripts/fetch-orgs.ts",
    "fetch:courses": "tsx --tsconfig server/tsconfig.json server/scripts/fetch-courses.ts",
    "fetch:greeks": "tsx --tsconfig server/tsconfig.json server/scripts/fetch-greeks.ts",
    "import:opportunities": "tsx --tsconfig server/tsconfig.json server/scripts/import-opportunities.ts",
    "test:lumi": "tsx --tsconfig server/tsconfig.json --test tests/lumi.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  }
}
