{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_MODE": "remote",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-RAILWAY-DOMAIN"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    },
    "demo": {
      "distribution": "internal",
      "channel": "demo",
      "env": { "EXPO_PUBLIC_API_MODE": "mock" },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
