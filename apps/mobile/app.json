{
  "expo": {
    "name": "AroundU",
    "slug": "aroundu",
    "version": "1.0.0",
    "scheme": "aroundu",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aroundu.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "시간표 이미지를 사진 앱에 저장할 때 사용해요.",
        "NSPhotoLibraryUsageDescription": "시간표 이미지를 사진 앱에 저장할 때 사용해요."
      }
    },
    "android": {
      "package": "app.aroundu.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F80ED"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F6F9FC",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "AroundU가 시간표 이미지를 사진에 저장합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "description": "Start with your university. Expand your circle. — 학교에서 시작해 사람을 발견하고, 만나고, 졸업 후에도 서클을 넓혀요.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {}
  }
}
