#!/usr/bin/env node
// local-stack — run Lumi (server + built web) locally from any git worktree with an isolated, seeded data file.
//   local-stack up [--worktree DIR] [--port N] [--data-file PATH] [--rebuild] [--reseed] [--dev [--web-port N]] [--autoreply]
//   local-stack down --port N | --all
//   local-stack status
import { up, down, status } from '../lib/stack.mjs';
import { parseArgs } from '../lib/args.mjs';

const { _: [cmd = 'help'], ...o } = parseArgs(process.argv.slice(2));
try {
  if (cmd === 'up') {
    const info = await up({ worktree: o.worktree, port: o.port, dataFile: o['data-file'], rebuild: !!o.rebuild, reseed: !!o.reseed, dev: !!o.dev, webPort: o['web-port'], autoreply: !!o.autoreply, keep: !!o.keep });
    console.log(JSON.stringify(info, null, 2));
    process.exit(0);
  } else if (cmd === 'down') {
    const ports = o.all ? status().map((s) => s.port) : [o.port];
    if (!ports.length || ports[0] === undefined) throw new Error('usage: local-stack down --port N | --all');
    for (const p of ports) console.log(`${p}: ${down(p) ? 'stopped' : 'not running (no pid file)'}`);
  } else if (cmd === 'status') {
    console.log(JSON.stringify(status(), null, 2));
  } else {
    console.log(`local-stack up [--worktree DIR] [--port N] [--data-file PATH] [--rebuild] [--reseed] [--dev [--web-port N]] [--autoreply]
local-stack down --port N | --all
local-stack status`);
  }
} catch (e) { console.error(`local-stack: ${e.message}`); process.exit(1); }
