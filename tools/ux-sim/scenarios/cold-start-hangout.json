{
  "id": "cold-start-hangout",
  "title": "Brand-new account: find someone on campus to hang out with this week",
  "goal": "You just heard about this app and want someone on campus to hang out with this week. Make an account with your school e-mail, then use the app to find a person or plan you could join this week and tell them you're in.",
  "startUrl": "/welcome",
  "setup": {
    "auth": "none",
    "notes": "Fresh account: sample profiles are shown only to demo accounts, so a new real user sees what a real first-week student sees (cold start)."
  },
  "success": {
    "description": "Signed up during the run AND, as that new account, joined/requested a plan, hosted one, sent a friend request or sent a chat message.",
    "all": [
      {
        "record": {
          "collection": "users",
          "where": {
            "id": "$me"
          },
          "fresh": "created",
          "description": "the account the browser is signed in to was created during this run"
        }
      }
    ],
    "any": [
      {
        "record": {
          "collection": "participations",
          "where": {
            "userId": "$me"
          },
          "description": "joined or asked to join a plan"
        }
      },
      {
        "record": {
          "collection": "activities",
          "where": {
            "hostId": "$me"
          },
          "description": "posted a plan"
        }
      },
      {
        "record": {
          "collection": "relationships.friendRequests",
          "where": {
            "fromId": "$me"
          },
          "description": "sent a friend request"
        }
      },
      {
        "record": {
          "collection": "timePolls",
          "where": {
            "hostId": "$me"
          },
          "description": "started a when-are-you-free poll"
        }
      },
      {
        "record": {
          "collection": "chatRooms",
          "where": {
            "memberIds": {
              "has": "$me"
            },
            "messages": {
              "some": {
                "senderId": "$me",
                "system": {
                  "exists": false
                }
              }
            }
          },
          "fresh": "changed",
          "description": "sent a chat message"
        }
      }
    ]
  },
  "expectedMinActions": 22,
  "personas": [
    "minji-freshman-17",
    "diego-transfer-commuter",
    "jordan-sophomore-impatient"
  ]
}
